# ==========================================
# LEVELUP Environment Variables
# ==========================================

# Server Port
PORT=5001

# Google Gemini API Key (Optional - Heuristic Multi-Agent Fallback Active if omitted)
GEMINI_API_KEY=

# Supabase PostgreSQL Configuration (Optional - In-Memory / File Database Active if omitted)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client Base URL
VITE_API_URL=http://localhost:5001

